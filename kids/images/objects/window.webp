<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="grad_window" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F0FDF4"/>
      <stop offset="100%" stop-color="#DCFCE7"/>
    </linearGradient>
    <filter id="shadow_window" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0F172A" flood-opacity="0.08" />
    </filter>
  </defs>
  <rect width="512" height="512" rx="64" fill="url(#grad_window)" />
  <circle cx="256" cy="230" r="170" fill="#ffffff" fill-opacity="0.85" filter="url(#shadow_window)" />
  <text x="256" y="245" font-size="180" text-anchor="middle" dominant-baseline="middle">🪟</text>
</svg>