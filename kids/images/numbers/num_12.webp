<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bg_num_12" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EFF6FF" />
      <stop offset="100%" stop-color="#DBEAFE" />
    </linearGradient>
    <radialGradient id="glow_num_12" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </radialGradient>
    <filter id="shadow_num_12" x="-15%" y="-15%" width="130%" height="130%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0F172A" flood-opacity="0.18" />
    </filter>
  </defs>
  <!-- Background Card -->
  <rect width="512" height="512" rx="96" fill="url(#bg_num_12)" />
  <circle cx="256" cy="256" r="210" fill="url(#glow_num_12)" />
  <!-- Main Content -->
  
    <g filter="url(#shadow_num_12)">
      <!-- Big Center Badge -->
      <circle cx="256" cy="180" r="110" fill="#FFFFFF" />
      <circle cx="256" cy="180" r="96" fill="#3B82F6" opacity="0.15" />
      <text x="256" y="225" font-family="'Rubik', 'Fredoka', 'Nunito', sans-serif" font-weight="900" font-size="120" fill="#1E3A8A" text-anchor="middle">12</text>
    </g>
    <!-- Countable Items -->
    <g>
      <text x="96" y="320" font-size="34" text-anchor="middle">🍎</text><text x="156" y="320" font-size="34" text-anchor="middle">🍎</text><text x="216" y="320" font-size="34" text-anchor="middle">🍎</text><text x="276" y="320" font-size="34" text-anchor="middle">🍎</text><text x="336" y="320" font-size="34" text-anchor="middle">🍎</text><text x="96" y="365" font-size="34" text-anchor="middle">🍎</text><text x="156" y="365" font-size="34" text-anchor="middle">🍎</text><text x="216" y="365" font-size="34" text-anchor="middle">🍎</text><text x="276" y="365" font-size="34" text-anchor="middle">🍎</text><text x="336" y="365" font-size="34" text-anchor="middle">🍎</text><text x="96" y="410" font-size="34" text-anchor="middle">🍎</text><text x="156" y="410" font-size="34" text-anchor="middle">🍎</text>
    </g>
  
</svg>